            "lesson_objective_id": "sel-noeval-obj-1",
            "instructional_type": "explain_then_practise",
            "note": "To round to the nearest ten, look at the units digit.\n47 rounds to 50 because 7 is 5 or more.\n23 rounds to 20, 85 rounds to 90 and 61 rounds to 60.\nTo round 3 472 to the nearest hundred, look at the tens digit: 7 is 5 or more, so 3 472 rounds to 3 500.\nTo the nearest thousand, 3 472 rounds to 3 000 because 4 is less than 5.",
            "blocks": [
              {
                "type": "explanation",
                "text": "Look at the digit to the right."
              }
            ],
