        "steps": [
          {
            "step_id": "sel-rich-01",
            "step_kind": "core",
            "lesson_objective_id": "sel-rich-obj-1",
            "instructional_type": "explain_then_practise",
            "note": "A multiple of a number is what you get when you multiply it by a whole number.\nExample: the multiples of 4 are 4, 8, 12, 16, 20, 24, 28.\nThe multiples of 7 are 7, 14, 21, 28, 35, 42.\n28 appears in both lists, so 28 is a common multiple of 4 and 7.\nThe lowest common multiple of 6 and 9 is 18, because the multiples of 6 are 6, 12, 18 and the multiples of 9 are 9, 18.",
            "blocks": [
              {
                "type": "explanation",
                "text": "Multiples come from multiplying."
              },
              {
                "type": "practice",
                "question": "List the first four multiples of 6."
              }
            ],
            "activities": [
              {
                "who": "teacher",
                "what": "Explains the rule and works an example"
              },
              {
                "who": "student",
                "what": "Solves questions in their notes"
              }
            ]
          },
          {
            "step_id": "sel-rich-02",
            "step_kind": "core",
            "lesson_objective_id": "sel-rich-obj-2",
            "instructional_type": "explain_then_practise",
            "note": "A factor divides a number exactly.\nExample: the factors of 12 are 1, 2, 3, 4, 6 and 12.\nThe factors of 18 are 1, 2, 3, 6, 9 and 18.\nThe common factors of 12 and 18 are 1, 2, 3 and 6, so their highest common factor is 6.\n30 = 2 x 3 x 5, which is its prime factorisation.",
            "blocks": [
              {
                "type": "worked_example",
                "text": "12 = 3 x 4, so 3 and 4 are factors."
              },
              {
                "type": "practice",
                "question": "List all the factors of 18."
              }
            ],
            "activities": [
              {
                "who": "teacher",
                "what": "Explains the rule and works an example"
              },
              {
                "who": "student",
                "what": "Solves questions in their notes"
              }
            ]
