DB_HOST=localhost
DB_PORT=3306
DB_NAME=lpcg
DB_USER=lpcg
DB_PASSWORD=lpcg
DATABASE_URL=mysql+pymysql://lpcg:lpcg@localhost:3306/lpcg

# --- LLM roles ----------------------------------------------------------------------
# Two roles, four fields each. They must be DIFFERENT models — a model marking its own
# homework is not a measurement — but they usually sit on one host, so leave the judge's
# base and key blank and it uses the generator's.
#
# PROVIDER is the WIRE FORMAT, and only two exist:
#     openai     -> OpenAI chat completions
#     anthropic  -> Anthropic messages
# It composes onto the model name, so each half has one source. Both Bedrock mantle and
# DeepSeek serve BOTH formats, on different paths — pick the base that matches the
# provider you set:
#
#     provider   Bedrock mantle                                    DeepSeek
#     ---------  ------------------------------------------------  -----------------------------
#     openai     https://bedrock-mantle.us-east-1.api.aws/v1       https://api.deepseek.com/v1
#     anthropic  https://bedrock-mantle.us-east-1.api.aws/v1       https://api.deepseek.com/anthropic
#
# Bedrock serves both on one base and switches by the path litellm appends, so the base
# is the same either way; DeepSeek needs the matching one. A trailing /chat/completions
# or /messages is trimmed, so pasting the full URL from a console works.
#
# `anthropic` is the better format wherever a model offers it: structured output rides
# tool-use, which the model does natively, instead of a response_format the OpenAI
# compatibility layer may accept without enforcing. What a model needs beyond that is
# recorded per model in app/infra/llm_models.py, never guessed from its name.
#
# Verify the ids before a run — it is a metadata call and costs no tokens. The console
# spellings (us.anthropic.claude-sonnet-5, openai.gpt-oss-120b-1:0) are NOT the ones
# mantle serves, and a wrong id fails at the first call as a 404 that reads like a dead
# endpoint:
#     uv run python -m experiments.h1_condition_eval.endpoint --check

BEDROCK_MANTLE_API_KEY=

# The judge runs on bedrock-runtime, NOT mantle: mantle refuses every Anthropic model on
# this account whatever its runtime agreement says. `bedrock` is not a URL — litellm signs
# with SigV4 through boto3, so base and key stay blank and AWS_PROFILE/AWS_REGION below
# carry the credentials instead.
#
# `converse/global.` is the cross-region inference profile. The bare id is rejected with
# "on-demand throughput isn't supported", which reads like a missing model rather than a
# missing prefix. Claude 5 is gated on this account — see AWS-SUPPORT-SONNET-5.md — so
# 4.6 is the newest that answers; swap in claude-sonnet-5 if that ever changes.

# Credentials for the bedrock-runtime judge. boto3 reads them from ~/.aws, so nothing
# secret belongs in this file for that route.
AWS_PROFILE=bedrock
AWS_REGION=us-east-1

# The frozen final generator, on DeepSeek. Swap the generator block over when that run
# comes. Either format works; the Anthropic one gives native tool-use:
#     GENERATOR_API_BASE=https://api.deepseek.com/anthropic
#     GENERATOR_API_KEY=<deepseek key>
#     GENERATOR_MODEL=deepseek-v4-flash
#     GENERATOR_PROVIDER=anthropic
# or, on the OpenAI-compatible path:
#     GENERATOR_API_BASE=https://api.deepseek.com/v1
#     GENERATOR_PROVIDER=openai
