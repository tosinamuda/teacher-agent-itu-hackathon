# Managed by ansible (roles/backend/templates/backend.env.j2) — edits here
# are overwritten on the next deploy.
# aiomysql (async, FastAPI) + pymysql (sync, scripts and jobs) are derived from this URL
# in src/app/db/session.py.
DB_HOST=localhost
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DATABASE_URL=mysql+pymysql://{{ db_user }}:{{ db_password }}@localhost:{{ db_port }}/{{ db_name }}


# The generator's key. The API does not start without it (src/app/infra/dspy_lm.py).
BEDROCK_MANTLE_API_KEY={{ bedrock_mantle_api_key }}

# The engine's key: the plugin writers run on DeepSeek (ROLES in src/app/infra/llm_models.py).
DEEPSEEK_API_KEY={{ deepseek_api_key }}

# Signs the short-lived download links the MCP server gives out for a slide deck.
DOWNLOAD_LINK_SECRET={{ download_link_secret }}

# Read access to the gated MSc study datasets, for scripts/seed_msc_study.py.
HF_TOKEN={{ hf_token }}

# The SPA is served from a different origin (Cloudflare Pages/Workers).
# Comma/whitespace-separated origin patterns the backend's CORS middleware
# allows — exact origins or `*` wildcards, e.g.
# "https://app.example.com,https://*.example.pages.dev". See src/app/cors.py.
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}
